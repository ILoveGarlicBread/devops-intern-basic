pipeline {
    agent {
        kubernetes {
            yaml '''
            apiVersion: v1
            kind: Pod
            spec:
              containers:
              - name: kaniko
                image: gcr.io/kaniko-project/executor:debug
                command: ["/busybox/sh", "-c"]
                args: ["cat"]
                tty: true
            '''
        }
    }
    
    environment {
        AWS_REGION     = 'ap-south-1'
        ECR_REGISTRY   = '205714230466.dkr.ecr.ap-south-1.amazonaws.com'
        REPO_NAME      = 'ai-agent'
        IMAGE_TAG      = "${GIT_COMMIT.take(7)}"
        GIT_REPO_URL   = 'ssh://git-codecommit.ap-south-1.amazonaws.com/v1/repos/TMA-DevOps-Lam-Internship'
        HELM_VALUES    = 'advanced/ai-agent/helm/ai-agent/values.yaml'
    }

    stages {
        stage('Build & Push to ECR (Kaniko)') {
            steps {
                // Use the Kaniko container for a Dockerless build!
                container('kaniko') {
                    dir('advanced/ai-agent/app') {
                        script {
                            echo "Building and pushing image to ${ECR_REGISTRY}/${REPO_NAME}:${IMAGE_TAG}..."
                            sh """
                            /kaniko/executor \\
                              --context `pwd` \\
                              --dockerfile `pwd`/Dockerfile \\
                              --destination ${ECR_REGISTRY}/${REPO_NAME}:${IMAGE_TAG} \\
                              --destination ${ECR_REGISTRY}/${REPO_NAME}:latest
                            """
                        }
                    }
                }
            }
        }

        stage('Update Helm Chart (GitOps)') {
            steps {
                // Switch back to the default Jenkins container which has git installed
                container('jnlp') {
                    script {
                        // Update the image tag in the values.yaml file using sed
                        sh """
                        sed -i "s/tag: .*/tag: \\"${IMAGE_TAG}\\"/" ${HELM_VALUES}
                        """
                        
                        // Commit and push the changes back to Git for ArgoCD to detect
                        withCredentials([sshUserPrivateKey(credentialsId: 'codecommit-ssh', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USERNAME')]) {
                            sh """
                            git config user.name "Jenkins CI"
                            git config user.email "jenkins@tma-demos.shop"
                            
                            # Set up Git to use the injected SSH key AND the AWS Key ID username
                            export GIT_SSH_COMMAND="ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no -o User=\${SSH_USERNAME}"
                            
                            git add ${HELM_VALUES}
                            git commit -m "ci(ai-agent): bump image tag to ${IMAGE_TAG} [skip ci]"
                            
                            # Push using SSH
                            git push ${GIT_REPO_URL} HEAD:main
                            """
                        }
                    }
                }
            }
        }
    }
}
